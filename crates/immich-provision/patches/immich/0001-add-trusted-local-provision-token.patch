 import { isAbsolute, join } from 'node:path';
 import { SALT_ROUNDS } from 'src/constants';
 import { MaintenanceAuthDto } from 'src/dtos/maintenance.dto';
@@ -62,6 +63,32 @@ export class CliService extends BaseService {
     return { admin, password, provided: !!providedPassword };
   }

+  async createProvisionToken(ttlSeconds: number): Promise<string> {
+    if (!Number.isSafeInteger(ttlSeconds) || ttlSeconds <= 0 || ttlSeconds > 3600) {
+      throw new Error('Provision token TTL must be an integer between 1 and 3600 seconds');
+    }
+
+    const admin = await this.userRepository.getAdmin();
+    if (!admin) {
+      throw new Error('Admin account does not exist');
+    }
+
+    const token = this.cryptoRepository.randomBytesAsText(32);
+    const hashed = this.cryptoRepository.hashSha256(token);
+    await this.sessionRepository.create({
+      token: hashed,
+      userId: admin.id,
+      parentId: null,
+      deviceOS: 'immich-admin',
+      deviceType: 'immich-provision',
+      appVersion: null,
+      oauthSid: null,
+      expiresAt: DateTime.now().plus({ seconds: ttlSeconds }).toJSDate(),
+    });
+
+    return token;
+  }
+
   async disablePasswordLogin(): Promise<void> {
     const config = await this.getConfig({ withCache: false });
     config.passwordLogin.enabled = false;
