diff --git a/server/src/commands/provision-token.command.ts b/server/src/commands/provision-token.command.ts
new file mode 100644
index 0000000..dabc77b
--- /dev/null
+++ b/server/src/commands/provision-token.command.ts
@@ -0,0 +1,40 @@
+import { Command, CommandRunner, Option } from 'nest-commander';
+import { CliService } from 'src/services/cli.service';
+
+type ProvisionTokenOptions = {
+  ttl?: number;
+};
+
+@Command({
+  name: 'provision-token',
+  description: 'Mint a short-lived admin session token for local declarative provisioning',
+})
+export class ProvisionTokenCommand extends CommandRunner {
+  constructor(private service: CliService) {
+    super();
+  }
+
+  async run(_passedParams: string[], options?: ProvisionTokenOptions): Promise<void> {
+    try {
+      const token = await this.service.createProvisionToken(options?.ttl ?? 300);
+      process.stdout.write(`${token}\n`);
+    } catch (error) {
+      console.error(error);
+      console.error('Unable to create provision token');
+      process.exitCode = 1;
+    }
+  }
+
+  @Option({
+    flags: '--ttl <seconds>',
+    description: 'Token lifetime in seconds',
+    defaultValue: 300,
+  })
+  parseTtl(value: string): number {
+    const ttl = Number.parseInt(value, 10);
+    if (!Number.isSafeInteger(ttl) || ttl <= 0 || ttl > 3600) {
+      throw new Error('--ttl must be an integer between 1 and 3600 seconds');
+    }
+    return ttl;
+  }
+}
